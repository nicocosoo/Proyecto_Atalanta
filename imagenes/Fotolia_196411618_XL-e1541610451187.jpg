<div class="wp-block-columns alignwide mt-xxl is-layout-flex wp-container-core-columns-is-layout-2 wp-block-columns-is-layout-flex">
<div class="wp-block-column is-layout-flow wp-block-column-is-layout-flow" style="flex-basis:100%">    <div class="full-searcher">
        <div class="searcher searcher-campus">
            <form method="get" class="form-buscador" action="https://fpceu.es/" id="form-buscador">

                <input type="text" class="field" name="s" autocomplete="off" placeholder="Quiero estudiar..." aria-label="Quiero estudiar..." value="">

                <select name="tipo" class="select-tipo" aria-label="Tipo">
                    <option value="">Tipo</option>
                                            <option value="cursos">Cursos</option>
                                            <option value="grado-medio">Grado Medio</option>
                                            <option value="grado-superior">Grado Superior</option>
                                            <option value="master-profesional">Máster</option>
                                    </select>
                
                <select name="modalidad" class="select-modalidad" aria-label="Modalidad">
                    <option value="">Modalidad</option>
                                            <option value="online">Online</option>
                                            <option value="presencial">Presencial</option>
                                            <option value="presencial-mananas">Presencial mañanas</option>
                                            <option value="presencial-tardes">Presencial tardes</option>
                                            <option value="semipresencial">Semipresencial</option>
                                    </select>

